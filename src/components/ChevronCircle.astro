---
interface Props {
  direction?: "up" | "down";
  class?: string;
  id?: string;
}

const { direction = "down", class: className = "nav-toggle-icon", id } = Astro.props;
---

<svg
  class={className}
  id={id}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <circle cx="12" cy="12" r="10"></circle>
  {
    direction === "down" ? (
      <path d="M8 10l4 4 4-4"></path>
    ) : (
      <path d="M8 14l4-4 4 4"></path>
    )
  }
</svg>
