---
import { connect, person, presence } from "../data/site";
---

<section class="content-shell my-8" aria-labelledby="contact-heading">
  <h2 class="section-heading mb-4" id="contact-heading">
    <span class="section-heading-inner">{connect.heading}</span>
  </h2>

  <div class="body-copy body-copy-in-shell text-center">
    {
      connect.paragraphs.map((paragraph) => (
        <p class="mb-4 last:mb-0">{paragraph}</p>
      ))
    }
  </div>

  <div class="flex flex-wrap justify-center gap-3">
    <a class="btn btn-soft btn-gmail" href={`mailto:${person.email}`}>
      Email
    </a>
    <a
      class="btn btn-soft btn-linkedin"
      href={presence.linkedin}
      target="_blank"
      rel="noopener noreferrer"
    >
      LinkedIn
    </a>
  </div>
</section>
